{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "plugins/**",
          "node_modules/@napi-rs/canvas/**",
          "node_modules/@napi-rs/canvas-linux-x64-gnu/**"
        ],
        "memory": 1024,
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}